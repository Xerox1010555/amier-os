{
  "name": "jarvis-desktop",
  "productName": "Amier OS",
  "version": "1.0.0",
  "description": "AI Operating System Assistant — desktop shell",
  "private": true,
  "license": "MIT",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev:vite": "vite --port 5173",
    "dev": "node scripts/dev-electron.mjs",
    "build:web": "vite build",
    "build": "npm run build:web && tsc -p tsconfig.node.json",
    "start": "electron .",
    "predist": "npm run build && node ../../scripts/prebuild-package.mjs",
    "dist": "electron-builder --win nsis portable",
    "package": "electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@jarvis/shared": "1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
