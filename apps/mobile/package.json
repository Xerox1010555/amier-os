{
  "name": "amier-mobile",
  "productName": "Amier OS",
  "version": "1.0.0",
  "description": "Amier OS — Android companion (plan · chat · status) for the AI orchestrator",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@jarvis/shared": "1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  },
  "scripts": {
    "dev": "vite --port 5180",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icon": "npx @capacitor/assets generate --assetPath assets",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android"
  }
}
