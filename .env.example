# ─── AI Orchestrator service ─────────────────────────────────────────────
# Provider: openai | anthropic | gemini | ollama | mock
JARVIS_LLM_PROVIDER=openai
JARVIS_LLM_MODEL=gpt-4o-mini
# API keys — prefer the OS keychain in production; these are read at startup:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Shared secret required by the desktop app (generate: openssl rand -hex 32)
JARVIS_SHARED_SECRET=
# Set to true (hosted/cloud mode) to require auth on every request:
JARVIS_REQUIRE_AUTH=true

# Bind the FastAPI orchestrator. LOCAL MODE MUST BE 127.0.0.1 — never 0.0.0.0.
JARVIS_BIND_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_REQUEST_TIMEOUT_S=20
JARVIS_MAX_STEPS_PER_PLAN=6
JARVIS_DAILY_TASK_LIMIT=200
JARVIS_LOG_LEVEL=INFO
JARVIS_CORS_ORIGINS=

# ─── Desktop app (Electron) ──────────────────────────────────────────────
# Path to the compiled Rust NAPI engine (.node binary)
JARVIS_CORE_PATH=
# SQLite database location (defaults to the OS user-data directory)
JARVIS_DB=
# Telemetry / crash reporting (opt-in only)
JARVIS_SENTRY_DSN=
