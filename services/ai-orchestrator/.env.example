# Jarvis AI orchestrator — environment template
# Copy to `.env` (same folder) and edit. All values optional; safe defaults shown.

# ── LLM provider ─────────────────────────────────────────────────────────────
# mock | ollama | openai | anthropic | gemini   ("mock" = deterministic, offline)
JARVIS_LLM_PROVIDER=mock
# Leave empty to use each provider's sensible default.
JARVIS_LLM_MODEL=

# Provider credentials — only needed for the matching provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
 # Local Ollama server (offline provider).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Server ───────────────────────────────────────────────────────────────────
JARVIS_BIND_HOST=127.0.0.1
JARVIS_PORT=8000
# Generate once:  python -c "import secrets; print(secrets.token_hex(32))"
# The desktop app stores this value in the OS keychain (Settings → shared secret).
JARVIS_SHARED_SECRET=
# Keep true for any real provider; set false only for fully local setups.
JARVIS_REQUIRE_AUTH=true
JARVIS_CORS_ORIGINS=

# ── Limits / ops ─────────────────────────────────────────────────────────────
JARVIS_REQUEST_TIMEOUT_S=20
JARVIS_MAX_STEPS_PER_PLAN=6
JARVIS_PLANS_RATE_LIMIT=10
JARVIS_DAILY_TASK_LIMIT=200
JARVIS_LOG_LEVEL=INFO
