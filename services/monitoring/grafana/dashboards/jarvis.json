{
  "title": "Jarvis OS — Orchestrator",
  "uid": "jarvis-orchestrator",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Requests / min",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "targets": [
        {
          "expr": "sum(rate(jarvis_requests_total[5m])) * 60",
          "legendFormat": "rpm"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Plans / min",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "targets": [
        {
          "expr": "sum(rate(jarvis_plans_total[5m])) * 60",
          "legendFormat": "plans"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Rate-limited / min",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "targets": [
        {
          "expr": "rate(jarvis_rate_limited_total[5m]) * 60",
          "legendFormat": "429s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Provider latency (p50/p95)",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, operation) (rate(jarvis_provider_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{operation}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(jarvis_provider_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{operation}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Plan size (steps)",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (le) (rate(jarvis_steps_per_plan_bucket[30m]))",
          "legendFormat": "le {{le}}"
        }
      ]
    }
  ]
}
